{
	"name": "pi-adapter-cf",
	"version": "0.1.0",
	"description": "Deploy pi-mono AI agents on Cloudflare Workers with Durable Objects. Dependency-injection friendly SDK.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./stubs/ajv": "./stubs/ajv.js"
	},
	"files": [
		"dist",
		"stubs",
		"README.md"
	],
	"scripts": {
		"postinstall": "patch-package",
		"build": "tsgo",
		"dev": "wrangler dev example/src/index.ts --config example/wrangler.toml",
		"deploy:example": "wrangler deploy --config example/wrangler.toml",
		"typecheck": "tsgo --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:crap": "crap-typescript --test-runner vitest --threshold 30 --format text src/",
		"clean": "rm -rf dist",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"release": "npm run build && npm publish --provenance --access public"
	},
	"keywords": [
		"cloudflare-workers",
		"durable-objects",
		"ai-agent",
		"pi-mono",
		"llm",
		"websocket"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/arlyon/pi-adapter-cf.git"
	},
	"homepage": "https://github.com/arlyon/pi-adapter-cf#readme",
	"bugs": {
		"url": "https://github.com/arlyon/pi-adapter-cf/issues"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^0.75.3",
		"@earendil-works/pi-ai": "^0.75.3"
	},
	"devDependencies": {
		"@barney-media/crap-typescript": "^0.3.0",
		"@biomejs/biome": "^2.4.15",
		"@cloudflare/workers-types": "^4.20250214.0",
		"@typescript/native-preview": "^7.0.0-beta",
		"@vitest/coverage-v8": "^4.1.6",
		"lefthook": "^2.1.8",
		"patch-package": "^8.0.1",
		"vitest": "^4.1.6",
		"wrangler": "^3.109.0"
	},
	"peerDependencies": {
		"@cloudflare/workers-types": ">=4.0.0"
	},
	"overrides": {
		"undici": "^6.21.0"
	}
}
